SECRET_KEY=your-secret-key
DEBUG=False
# Customer email: keep disabled until sender, SMTP and HTTPS portal origin are verified.
CUSTOMER_EMAIL_ENABLED=False
CUSTOMER_REQUIRE_EMAIL_VERIFICATION=False
CUSTOMER_PUBLIC_ORIGIN=
# Exact Nginx source IPs only, after verifying X-Real-IP is overwritten by Nginx.
CUSTOMER_TRUSTED_PROXY_IPS=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Operator-only staging/testing; can create a real VPS.
ALLOW_TEST_PAYMENT=False
# Enable only after Windows provisioning and public RDP are verified.
WINDOWS_ORDERING_ENABLED=False
# Enable only after the separate Ubuntu Server template and VM100 mapping are verified.
UBUNTU_SERVER_ORDERING_ENABLED=False

DB_NAME=cloud_portal_db
DB_USER=cloud_portal_user
DB_PASSWORD=your-database-password
DB_HOST=10.50.0.23
DB_PORT=5432

# Provisioning server origin; HTTP opt-in is only for trusted internal/testing networks.
PROVISIONING_API_URL=
PROVISIONING_ALLOW_HTTP=False
BILLING_API_SECRET=
# Set to an OS identifier accepted by VM100 before testing provisioning.
PROVISIONING_DEFAULT_OS=Ubuntu 26.04

# One-time Xendit hosted checkout. Leave empty to disable.
XENDIT_SECRET_API_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BUSINESS_ID=
XENDIT_PUBLIC_BASE_URL=

# Hestia web-hosting package discovery (keep the password out of Git).
HESTIA_API_URL=https://10.50.0.24:8083/api/
HESTIA_API_USER=selwyn
HESTIA_API_PASSWORD=
HESTIA_API_VERIFY_SSL=False
HESTIA_API_TIMEOUT=5
